# Server
PORT=5001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=carbonsync_emissions

# Emissions factor APIs
CLIMATIQ_API_KEY=your-climatiq-api-key
CLIMATIQ_DATA_VERSION=^21
DEFAULT_INVOICE_REGION=IN

# Gemini (LLM + vision/OCR)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_TIMEOUT_MS=15000
GEMINI_VISION_MAX_MODELS=2
GEMINI_VISION_ATTEMPTS_PER_MODEL=1
GEMINI_VISION_MODEL=gemini-2.0-flash-lite
GEMINI_VISION_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash

# Invoice backend (frontend talks to this)
BASE_URL=http://localhost:5000

# Affinda (invoice extraction)
AFFINDA_API_KEY=your-affinda-api-key
AFFINDA_WORKSPACE_ID=your-affinda-workspace-id
AFFINDA_DOCUMENT_TYPE_ID=your-affinda-document-type-id

# Mistral OCR
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest
OCR_MAX_PAGES=1
OCR_SCALE=1.5
OCR_PAGE_TIMEOUT_MS=12000
OCR_RENDER_TIMEOUT_MS=10000
OCR_PDF_LOAD_TIMEOUT_MS=10000
DISABLE_HEAVY_PDF_OCR=true